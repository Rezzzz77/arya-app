# --- AI (required) ---
# Provider: deepseek | openai | gemini
AI_PROVIDER=gemini
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_MODEL=gemini-3.5-flash-lite
AI_API_KEY=

# اگر خواستی به DeepSeek برگردی (کلیدش جداست):
# AI_PROVIDER=deepseek
# AI_BASE_URL=https://api.deepseek.com
# AI_MODEL=deepseek-flash
# AI_API_KEY=

# --- Cloudflare (wrangler reads .env automatically; also set as Worker secrets) ---
ARYA_API=https://arya-api.arshadirad7475.workers.dev
PAGES_PROJECT=arya-app
CF_ACCOUNT_ID=
CF_API_TOKEN=
# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=
# Optional: daily cap per user (default 10)
DAILY_LIMIT=10
